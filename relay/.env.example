# Shared secret. Generate with: openssl rand -hex 32
FAMILYBOX_TOKEN=changeme

# Where media and the SQLite index live.
# Leave this COMMENTED OUT for Docker: the image already points it at the
# /data volume, and setting it here overrides that and breaks startup.
# Uncomment only when running the relay directly on a machine, not in Docker.
#FAMILYBOX_DATA=./media

# Push notifications to your phone when a reply arrives.
# Install the ntfy app, subscribe to this topic. Pick something unguessable.
FAMILYBOX_NTFY_TOPIC=
FAMILYBOX_NTFY_SERVER=https://ntfy.sh

# LVGL on ESP32 reads RGB565 buffers as native little-endian, so 0 is correct.
# Flip to 1 only if colours come out wrong on the panel.
RGB565_BIG_ENDIAN=0

# Cap on a single voice note
MAX_AUDIO_SEC=60
